{"OEM": "CALIBRATION_REQUIRED", "customer_originals": {"diagram_status": "FUNCTIONAL_RECONSTRUCTION_NOT_SIGNED_CUSTOMER_PID", "documents": [{"document": "00_26025\u9879\u76ee\u9ad8\u5bc6\u5ea6\u6db2\u51b7\u6570\u636e\u4e2d\u5fc3\u5efa\u8bbe\u65b9\u6848_v9_\u5ba2\u6237\u786e\u5b9a\u65b9\u6848_20260926.docx", "locator": "word/document.xml body descendant w:p zero-based index; NOT a rendered page number", "paragraphs": [{"text": "\u5168\u9879\u76ee90\u67dc\uff0c5\u4e2a18\u67dc\u5927\u7ec4\uff1b\u6bcf\u5927\u7ec43\u4e2a6\u67dc\u5355\u5143\u3002\u6bcf\u5355\u51432\u53f0CDU\u4e00\u7528\u4e00\u5907\u53ca2\u5957\u72ec\u7acb\u4e8c\u6b21\u4f9b\u56de\u73af\u7f51\uff1b\u6bcf\u5927\u7ec46\u53f0CDU\uff0c3\u75283\u5907\u3002\u5168\u573a30\u53f0CDU\u300130\u5957\u4e8c\u6b21\u73af\u7f51\u300110\u5957\u4e00\u6b21\u73af\u7f51\u3002 \u6bcf18\u67dcD1/D2\u5404\u75313\u4e2aBKC11.3*2.3\u5e72\u51b7\u6a21\u5757\u5e76\u8054\u7ec4\u6210\uff0cW1/W2\u5404\u75315\u4e2aGESC-K70B23DE\u6e7f\u51b7\u6a21\u5757\u5e76\u8054\u7ec4\u6210\uff1b\u6bcf\u5957\u5355\u5143330 m\u00b3/h\u3001\u4e24\u5e72\u4e92\u5907\u4e24\u6e7f\u4e92\u5907\u3002\u5168\u573a30\u5e72\u6a21\u5757\u300150\u6e7f\u6a21\u5757\uff0c\u5206\u522b\u7ec4\u621010\u5957\u5e72\u51b7\u53ca10\u5957\u6e7f\u51b7\u5355\u5143\u3002A/B\u4e00\u6b21\u4f9b\u56de\u73af\u7f51\u72ec\u7acb\u4e00\u7528\u4e00\u5907\uff0c\u4fdd\u7559\u5404\u81ea\u5206\u5c42\u7f50\u4e0e\u8d1f\u8377\u6cf5\uff1b\u6e90\u4fa7\u5171\u75284\u6cf5\u6b63\u5e383\u75281\u5907\uff0c\u7ecf\u9009\u62e9\u9600\u670d\u52a1\u5355\u4e00\u73af\u7f51\uff1b\u5206\u6bb5\u56de\u5145\u540e\u53ef\u6295\u5165\u7b2c4\u6cf5\u6062\u590d\u8fd0\u884c\u7f50\u51b7\u91cf\uff0cA/B\u4e0d\u5e76\u901a\uff0c\u8bbe\u5907\u6570\u91cf\u4e0d\u589e\u52a0\u3002", "xml_paragraph_zero_based": 25}, {"text": "\u672c\u9636\u6bb5\u4e3a\u521d\u6b65\u8bbe\u8ba1\u8ba1\u7b97\uff0c\u672a\u505aCFD\u3001\u77ac\u6001\u4eff\u771f\u6216\u5b9e\u673a\u9a8c\u8bc1\u3002\u6027\u80fd\u4fdd\u8bc1\u4f9d\u636e\u73b0\u9636\u6bb5\u4e0d\u4f5c\u4e3a\u66f4\u65b0\u524d\u7f6e\u6761\u4ef6\uff1b\u7cfb\u7edf\u8fde\u63a5\u53c2\u8003\u73b0\u5b58R10\uff0c\u56de\u5145\u6309\u672c\u8f6e\u786e\u8ba4\u4fee\u8ba2\uff0c\u65b0\u7248P&ID\u5f85\u5f52\u6863\uff0c\u5b9e\u9645\u6cf5\u66f2\u7ebf\u3001\u7ba1\u8def\u51e0\u4f55\u3001\u627f\u538b\u548c\u4f9b\u8d27\u63a5\u53e3\u572808\u786e\u8ba4\u6e05\u5355\u4e2d\u4fdd\u7559\u5f85\u529e\u3002", "xml_paragraph_zero_based": 37}, {"text": "\u56fe5a\u533a\u5206\u6e90\u4fa7\u5faa\u73af\u4e0e\u8d1f\u8377\u4fa7\u5faa\u73af\uff1a\u6e90\u6cf5\u4ece\u5206\u5c42\u7f50\u70ed\u4fa7\u53d6\u6db2\uff0c\u7ecf\u8fd0\u884c\u51b7\u6e90\u51b7\u5374\u540e\u8fd4\u56de\u51b7\u4fa7\uff1b\u8d1f\u8377\u6cf5\u4ece\u51b7\u4fa7\u5411CDU\u4f9b\u6db2\uff0cCDU\u70ed\u56de\u6db2\u8fd4\u56de\u7f50\u70ed\u4fa7\u3002\u5206\u5c42\u7f50\u4f7f\u4e24\u7c7b\u5faa\u73af\u7684\u6cf5\u538b\u5dee\u5206\u522b\u627f\u62c5\u5404\u81ea\u8def\u5f84\u635f\u5931\uff1b\u793a\u610f\u56fe\u4e0d\u66ff\u4ee3\u9600\u4f4d\u3001\u63a5\u7ba1\u987a\u5e8f\u548c\u8054\u9501\u9f50\u5168\u7684\u65bd\u5de5PID\u3002", "xml_paragraph_zero_based": 455}, {"text": "\u672c\u8282\u5217\u660e\u8fde\u7eed\u538b\u529b\u8def\u5f84\u53ca\u8282\u70b9\u8868\u538b\u3002\u8bbe\u8ba1\u8981\u6c42\u4e3a\u6240\u6709\u4e00\u6b21\u4fa7\u6e90\u6cf5\u3001\u8d1f\u8377\u6cf5\u548c\u4e8c\u6b21\u6cf5\u5165\u53e3\u8868\u538b\u226550 kPa\uff0c\u677f\u6362\u4e00\u6b21\u3001\u4e8c\u6b21\u5165\u53e3\u8868\u538b\u5dee\u7684\u7edd\u5bf9\u503c\u226410 kPa\u3002\u8be510 kPa\u4e0d\u6307\u5355\u4fa7\u8fdb\u51fa\u53e3\u538b\u964d\uff0c\u4e5f\u4e0d\u6307\u677f\u7247\u4e24\u9762\u5404\u4f4d\u7f6e\u7684\u538b\u5dee\u3002\u56fe7a\u3001\u56fe8a\u5217\u9ad8\u6e29\u7a33\u6001\u8bbe\u8ba1\u70b9\uff1b\u6e90\u4fa7\u4e0e\u8d1f\u8377\u4fa7\u7ecf\u5171\u540c\u5206\u5c42\u7f50\u89e3\u8026\uff0c\u5404\u81ea\u6210\u73af\uff0c\u4e0d\u53e0\u52a0\u4e3a\u5355\u6cf5\u626c\u7a0b\u3002", "xml_paragraph_zero_based": 469}, {"text": "\u5907\u7528\u7f50\u91c7\u7528\u5206\u6bb5\u8865\u51b7\uff1a\u8fd0\u884cA\u65f6\u77ed\u65f6\u5207\u5171\u7528\u6e90\u6cf5\u7ed9B\u8865\u51b7\uff0c\u9650\u65f6\u8fd4\u56deA\u540e\u5141\u8bb8\u7b2c4\u53f0\u6e90\u6cf5\u4e34\u65f6\u6295\u5165\uff1b\u8d1f\u8377\u4fa7\u4fdd\u6301330 m\u00b3/h\uff0c\u7528\u6e90\u4fa7\u9ad8\u4e8e\u8d1f\u8377\u4fa7\u7684\u6709\u6548\u51b7\u6db2\u6d41\u91cf\u6062\u590dA\u50a8\u51b7\u91cf\u3002A\u6062\u590d\u5408\u683c\u540e\u65b9\u53ef\u8fdb\u884c\u4e0b\u4e00\u8f6eB\u8865\u51b7\uff1bB\u8fd0\u884c\u65f6\u5bf9\u79f0\u6267\u884c\u3002\u4e0d\u65b0\u589e\u56de\u5145\u6cf5\uff0c\u4e0d\u91c7\u7528\u53cc\u6e7f\u5854\u5206\u522b\u7ed9A/B\u540c\u65f6\u4f9b\u51b7\u7684\u72ec\u7acb\u56de\u5145\u65b9\u6848\u3002", "xml_paragraph_zero_based": 716}, {"text": "\u6b63\u5e38\u6e90\u4fa73\u75281\u5907\u3001330 m\u00b3/h\uff1b\u56db\u6cf5\u6062\u590d\u9636\u6bb5\u603b\u6d41\u91cf\u6309\u6cf5\u5e76\u8054\u5de5\u4f5c\u70b9\u3001\u51b7\u5854\u6d41\u91cf\u4e0e\u6392\u70ed\u80fd\u529b\u3001\u7ba1\u9600\u538b\u964d\u53ca\u4f9b\u6e29\u5171\u540c\u9650\u5e45\uff0c440 m\u00b3/h\u4ec5\u4e3a4\u00d7110\u7684\u7b97\u4f8b\uff0c\u4e0d\u662f\u8fd0\u884c\u8bbe\u5b9a\u6216\u5382\u5bb6\u4fdd\u8bc1\u3002\u4e00\u6b21A/B\u59cb\u7ec8\u4e0d\u5e76\u901a\uff0c\u51b7\u6e90\u6301\u7eed\u8fd0\u884c\u7ec4\u5408\u4ecd\u4ec51\u5e72\u30011\u5e72\uff0b1\u6e7f\u62161\u6e7f\u3002", "xml_paragraph_zero_based": 717}, {"text": "\u5171\u7528\u6e90\u6cf5\u6362\u7f51\u987a\u5e8f\uff1a\u8fd0\u884c\u8d1f\u8377\u6cf5\u6301\u7eed\u4f9b\u6db2\u2192\u6e90\u6cf5\u5378\u8f7d\u5e76\u786e\u8ba4\u505c\u6cf5\u2192\u5173\u95ed\u65e7\u7f51\u4f9b\u56de\u9009\u62e9\u9600\u5e76\u786e\u8ba4\u2192\u76ee\u6807\u7f51\u4f9b\u56de\u6210\u5bf9\u5efa\u7acb\u5408\u6cd5\u6d41\u8def\u2192\u786e\u8ba4\u9600\u4f4d\u540e\u542f\u6cf5\u3002\u8fd4\u56de\u8fd0\u884c\u7f51\u540c\u5e8f\u3002\u8865\u51b7\u6709\u6548\u65f6\u95f4\u5fc5\u987b\u6263\u9664\u5f80\u8fd4\u505c\u542f\u6cf5\u3001\u5207\u9600\u3001\u5efa\u6d41\u548c\u786e\u8ba4\u65f6\u95f4\uff1b\u4e0d\u80fd\u628a114.55 s\u7406\u8bba\u50a8\u51b7\u65f6\u95f4\u5168\u90e8\u7528\u4e8e\u8865\u51b7\u3002", "xml_paragraph_zero_based": 718}, {"text": "\u56de\u5145\u7b97\u4f8b\uff1a\u8fd0\u884c\u7f50\u65ad\u5f00\u6e90\u4fa760 s\u6d88\u8017\u51b7\u6db2330\u00d760/3600\uff1d5.50 m\u00b3\uff1b\u82e5\u6838\u51c6\u6062\u590d\u6d41\u91cf\u4e3a440 m\u00b3/h\uff0c\u51c0\u8865\u51b7110 m\u00b3/h\uff0c\u7406\u60f3\u6062\u590d\u7ea63 min\u3002\u6309\u73b0\u67097.34 K\u6e29\u5dee\uff0c\u51b7\u6e90\u70ed\u9700\u6c42\u7ea63.62 MW\u4e14\u9700\u53e6\u6838\u6cf5\u70ed\uff0c\u8d85\u8fc7\u5355\u6e7f\u989d\u5b9a3.30 MW\uff0c\u6545\u4e0d\u80fd\u76f4\u63a5\u91c7\u7528440\u3002\u5b9e\u9645\u6062\u590d\u65f6\u95f4\u6309t\uff1dV\u6d88\u8017/(Q\u6e90\u2212330)\u00d760 min\u8ba1\u7b97\uff0c\u524d\u63d0\u662fQ\u6e90>330\u4e14\u51b7\u6db2\u5408\u683c\u3002\u5b9e\u9645\u5faa\u73af\u5468\u671f\u53ca\u5168\u5e74\u6b21\u6570\u5c1a\u672a\u786e\u5b9a\u3002", "xml_paragraph_zero_based": 719}, {"text": "\u56db\u6cf5\u4e34\u65f6\u8fd0\u884c\u671f\u95f4\u65e0\u95f2\u7f6e\u5907\u7528\u6cf5\u3002\u4efb\u4e00\u6cf5\u6545\u969c\u7acb\u5373\u7ec8\u6b62\u50a8\u51b7\u6062\u590d\uff0c\u4f18\u5148\u4fdd\u969c\u8fd0\u884c\u73af\u7f51330 m\u00b3/h\uff1b\u5269\u4f59\u4e09\u6cf5\u80fd\u5426\u63a5\u7ba1\u53ca\u52a8\u6001\u8fde\u7eed\u6027\u987b\u9a8c\u8bc1\u3002\u6e29\u5ea6\u3001\u6d41\u91cf\u3001\u538b\u529b\u6216\u5269\u4f59\u50a8\u51b7\u4e0d\u6ee1\u8db3\u8bb8\u53ef\u65f6\u7981\u6b62\u8ba1\u5212\u8865\u51b7\uff1b\u4e0d\u4ee5IT\u964d\u8f7d\u5b8c\u6210\u6b63\u5e38\u56de\u5145\u3002", "xml_paragraph_zero_based": 720}, {"text": "\u6bcf18\u67dcA/B\u73af\u7f51\u5404\u914d1\u53f015 m\u00b3\u627f\u538b\u5206\u5c42\u7f13\u51b2\u7f50\uff0c\u4e24\u4e2a\u6db2\u8def\u72ec\u7acb\u3002\u7f50\u9876\u90e8\u63a5CDU\u70ed\u56de\u6db2\u4e0e\u51b7\u6e90\u6cf5\u5438\u5165\u53e3\uff0c\u5e95\u90e8\u63a5\u51b7\u5854\u51b7\u51fa\u6db2\u4e0e\u8d1f\u8377\u6cf5\u5438\u5165\u53e3\uff1b\u51b7\u70ed\u53e3\u8bbe\u5e03\u6c34\u5668\u3002\u6bcf\u73af\u7f51\u914d2\u53f0100%\u8d1f\u8377\u6cf5\u4e00\u7528\u4e00\u5907\uff0c\u51b7\u6e90\u5207\u6362\u65f6\u8fd0\u884c\u8d1f\u8377\u6cf5\u4ecd\u5411CDU\u4f9b\u6db2330 m\u00b3/h\u3002\u6309\u5efa\u51b760 s\uff08\u542b\u6545\u969c\u68c0\u6d4b\uff09\u52a0\u7f6e\u636230 s\uff0c\u5b8c\u6574\u4e8b\u4ef6\u226490 s\uff1b\u6240\u9700\u53ef\u4ea4\u4ed8\u51b7\u6db28.25 m\u00b3\uff0c\u6bcf\u7f50\u630970%\u6709\u6548\u91cf\u4e3a10.50 m\u00b3\uff0c\u7406\u8bba114.55 s\u3002\u4f9b\u5e94\u5546\u987b\u4fdd\u8bc1\u5b9e\u9645PG\u53ca\u6700\u5927\u56de\u6e29\u3001330 m\u00b3/h\u4e0b\u6301\u7eed90 s\u51fa\u6db2\u5347\u6e29\u22640.5 K\uff1b15 m\u00b3\u666e\u901a\u6df7\u5408\u7f50\u4e0d\u53ef\u66ff\u4ee3\u3002", "xml_paragraph_zero_based": 724}, {"text": "\u6bcf18\u67dc\u4e24\u8def\u72ec\u7acbUPS\u53ca\u7535\u6c60\uff0c\u5404500 kVA/400 kW\u3001\u6ee1\u8bbe\u8ba1\u8d1f\u8377\u540e\u590710 min\uff1b\u4efb\u4e00\u8def\u627f\u62c5\u8fd0\u884cCDU\u3001\u8d1f\u8377\u6cf5\u53ca\u63a7\u5236\u3002\u8fde\u7eed\u4e0a\u96503\u00d763\uff0b37\uff0b5\uff1d231 kW\uff0c\u5207\u6362\u77ed\u65f64\u00d763\uff0b2\u00d737\uff0b5\uff1d331 kW\uff0c\u5747\u5c0f\u4e8e400 kW\u3002\u4ec5\u5141\u8bb8\u5fc5\u8981\u7684\u4e00\u5bf9CDU\u53ca\u4e00\u5bf9\u8d1f\u8377\u6cf5\u77ed\u65f6\u91cd\u53e0\uff0c\u4e0d\u5141\u8bb8\u591a\u7ec4\u540c\u65f6\u91cd\u53e0\u3002\u51b7\u5854\u98ce\u673a\u3001\u51b7\u6e90\u6cf5\u7531\u72ec\u7acb\u6b63\u5e38/\u5e94\u6025\u4f9b\u7535\u4fdd\u969c\uff0c\u6e90\u4fa7\u6062\u590d\u7eb3\u516590 s\u51b7\u91cf\u6062\u590d\u65f6\u9650\u3002UPS\u768410 min\u7535\u529b\u4fdd\u6301\u4e0d\u7b49\u4e8e10 min\u70ed\u7f13\u51b2\u3002", "xml_paragraph_zero_based": 726}, {"text": "\u5907\u7528CDU\u53ca\u4e8c\u6b21\u73af\u7f51\u9650\u5b9a\u5728\u54046\u67dc\u5355\u5143\u5185\uff0c\u4e0d\u505a6\u53f0CDU\u8de8\u5355\u5143\u5168\u4ea4\u53c9\u4e92\u5907\u3002\u6bcf\u5854\u53caCDU\u4f9b\u56de\u4e24\u7aef\u8bbe\u7f6e\u72ec\u7acb\u7535\u52a8\u9009\u62e9\u9600\uff0c\u5148\u786e\u8ba4\u539f\u73af\u7f51\u9694\u79bb\u518d\u63a5\u5165\u53e6\u4e00\u73af\u7f51\uff1b\u4f9b\u56de\u5fc5\u987b\u540c\u5c5eA\u6216B\u3002\u63a5\u53e3\u5171\u7528\u6bb5\u7f29\u77ed\u81f3\u76f4\u63a5\u8fde\u63a5\u7684\u4e09\u901a\u6bb5\uff0c\u90bb\u8fd1\u652f\u8def\u91c7\u7528\u5bf9\u5939\u8776\u9600\u7269\u7406\u9694\u79bb\u5e76\u53cd\u9988\u9600\u4f4d\u3002\u6b62\u56de\u9600\u4e0d\u80fd\u66ff\u4ee3\u68c0\u4fee\u9694\u79bb\uff0c\u5171\u7528\u63a5\u53e3\u672c\u4f53\u6545\u969c\u4ecd\u9700\u5206\u533a\u5904\u7f6e\u3002", "xml_paragraph_zero_based": 757}, {"text": "\u4e00\u6b21\u4fa7\u6bcf18\u67dc\u914d\u7f6eA/B\u4e24\u5957\u72ec\u7acb\u4f9b\u56de\u73af\u7f51\uff0c\u5168\u573a10\u5957\uff1b\u4e8c\u6b21\u4fa7\u6bcf6\u67dc\u4e24\u5957\u72ec\u7acb\u4f9b\u56de\u73af\u7f51\uff0c\u5168\u573a30\u5957\u3002A/B\u8868\u793a\u5b8c\u6574\u5907\u7528\u7ba1\u7f51\uff0c\u4e0d\u662f\u4f9b\u6db2\u548c\u56de\u6db2\u7684\u4ee3\u53f7\u3002\u6e90\u4fa7\u3001\u8d1f\u8377\u4fa7\u3001\u4e8c\u6b21\u4fa7\u5206\u522b\u6838\u7b97\u6d41\u91cf\u548c\u635f\u5931\uff0c\u8fd0\u884c\u538b\u5dee\u7528\u4e8e\u6cf5\u70ed\u9884\u7b97\uff0c\u9009\u578b\u4f59\u91cf\u53ea\u5728\u9009\u6cf5\u65f6\u8ba1\u5165\u3002", "xml_paragraph_zero_based": 865}], "raw_sha256": "f366d8001fdb785c5b41cf149886eefac1ad9e79d1b498f0244cc2cdffd915b7", "status": "ORIGINAL_REOPENED_AND_PARAGRAPHS_MATCH"}, {"document": "01_\u65b9\u6848\u4ecb\u7ecd_\u4e2d\u6587_v9_\u5ba2\u6237\u786e\u5b9a\u65b9\u6848_20260926.docx", "locator": "word/document.xml body descendant w:p zero-based index; NOT a rendered page number", "paragraphs": [{"text": "\u5168\u9879\u76ee90\u67dc\uff0c5\u4e2a18\u67dc\u5927\u7ec4\uff1b\u6bcf\u5927\u7ec43\u4e2a6\u67dc\u5355\u5143\u3002\u6bcf\u5355\u51432\u53f0CDU\u4e00\u7528\u4e00\u5907\u53ca2\u5957\u72ec\u7acb\u4e8c\u6b21\u4f9b\u56de\u73af\u7f51\uff1b\u6bcf\u5927\u7ec46\u53f0CDU\uff0c3\u75283\u5907\u3002\u5168\u573a30\u53f0CDU\u300130\u5957\u4e8c\u6b21\u73af\u7f51\u300110\u5957\u4e00\u6b21\u73af\u7f51\u3002", "xml_paragraph_zero_based": 3}, {"text": "\u6bcf18\u67dcD1/D2\u5404\u75313\u4e2aBKC11.3*2.3\u5e72\u51b7\u6a21\u5757\u5e76\u8054\u7ec4\u6210\uff0cW1/W2\u5404\u75315\u4e2aGESC-K70B23DE\u6e7f\u51b7\u6a21\u5757\u5e76\u8054\u7ec4\u6210\uff1b\u6bcf\u5957\u5355\u5143330 m\u00b3/h\u3001\u4e24\u5e72\u4e92\u5907\u4e24\u6e7f\u4e92\u5907\u3002\u5168\u573a30\u5e72\u6a21\u5757\u300150\u6e7f\u6a21\u5757\uff0c\u5206\u522b\u7ec4\u621010\u5957\u5e72\u51b7\u53ca10\u5957\u6e7f\u51b7\u5355\u5143\u3002A/B\u4e00\u6b21\u4f9b\u56de\u73af\u7f51\u72ec\u7acb\u4e00\u7528\u4e00\u5907\uff0c\u4fdd\u7559\u5404\u81ea\u5206\u5c42\u7f50\u4e0e\u8d1f\u8377\u6cf5\uff1b\u6e90\u4fa7\u5171\u75284\u6cf5\u6b63\u5e383\u75281\u5907\uff0c\u7ecf\u9009\u62e9\u9600\u670d\u52a1\u5355\u4e00\u73af\u7f51\uff1b\u5206\u6bb5\u56de\u5145\u540e\u53ef\u6295\u5165\u7b2c4\u6cf5\u6062\u590d\u8fd0\u884c\u7f50\u51b7\u91cf\uff0cA/B\u4e0d\u5e76\u901a\uff0c\u8bbe\u5907\u6570\u91cf\u4e0d\u589e\u52a0\u3002", "xml_paragraph_zero_based": 45}, {"text": "\u6bcf18\u67dcA/B\u73af\u7f51\u5404\u914d1\u53f015 m\u00b3\u627f\u538b\u5206\u5c42\u7f13\u51b2\u7f50\uff0c\u4e24\u4e2a\u6db2\u8def\u72ec\u7acb\u3002\u7f50\u9876\u90e8\u63a5CDU\u70ed\u56de\u6db2\u4e0e\u51b7\u6e90\u6cf5\u5438\u5165\u53e3\uff0c\u5e95\u90e8\u63a5\u51b7\u5854\u51b7\u51fa\u6db2\u4e0e\u8d1f\u8377\u6cf5\u5438\u5165\u53e3\uff1b\u51b7\u70ed\u53e3\u8bbe\u5e03\u6c34\u5668\u3002\u6bcf\u73af\u7f51\u914d2\u53f0100%\u8d1f\u8377\u6cf5\u4e00\u7528\u4e00\u5907\uff0c\u51b7\u6e90\u5207\u6362\u65f6\u8fd0\u884c\u8d1f\u8377\u6cf5\u4ecd\u5411CDU\u4f9b\u6db2330 m\u00b3/h\u3002\u6309\u5efa\u51b760 s\uff08\u542b\u6545\u969c\u68c0\u6d4b\uff09\u52a0\u7f6e\u636230 s\uff0c\u5b8c\u6574\u4e8b\u4ef6\u226490 s\uff1b\u6240\u9700\u53ef\u4ea4\u4ed8\u51b7\u6db28.25 m\u00b3\uff0c\u6bcf\u7f50\u630970%\u6709\u6548\u91cf\u4e3a10.50 m\u00b3\uff0c\u7406\u8bba114.55 s\u3002\u4f9b\u5e94\u5546\u987b\u4fdd\u8bc1\u5b9e\u9645PG\u53ca\u6700\u5927\u56de\u6e29\u3001330 m\u00b3/h\u4e0b\u6301\u7eed90 s\u51fa\u6db2\u5347\u6e29\u22640.5 K\uff1b15 m\u00b3\u666e\u901a\u6df7\u5408\u7f50\u4e0d\u53ef\u66ff\u4ee3\u3002", "xml_paragraph_zero_based": 49}, {"text": "\u6bcf18\u67dc\u4e24\u8def\u72ec\u7acbUPS\u53ca\u7535\u6c60\uff0c\u5404500 kVA/400 kW\u3001\u6ee1\u8bbe\u8ba1\u8d1f\u8377\u540e\u590710 min\uff1b\u4efb\u4e00\u8def\u627f\u62c5\u8fd0\u884cCDU\u3001\u8d1f\u8377\u6cf5\u53ca\u63a7\u5236\u3002\u8fde\u7eed\u4e0a\u96503\u00d763\uff0b37\uff0b5\uff1d231 kW\uff0c\u5207\u6362\u77ed\u65f64\u00d763\uff0b2\u00d737\uff0b5\uff1d331 kW\uff0c\u5747\u5c0f\u4e8e400 kW\u3002\u4ec5\u5141\u8bb8\u5fc5\u8981\u7684\u4e00\u5bf9CDU\u53ca\u4e00\u5bf9\u8d1f\u8377\u6cf5\u77ed\u65f6\u91cd\u53e0\uff0c\u4e0d\u5141\u8bb8\u591a\u7ec4\u540c\u65f6\u91cd\u53e0\u3002\u51b7\u5854\u98ce\u673a\u3001\u51b7\u6e90\u6cf5\u7531\u72ec\u7acb\u6b63\u5e38/\u5e94\u6025\u4f9b\u7535\u4fdd\u969c\uff0c\u6e90\u4fa7\u6062\u590d\u7eb3\u516590 s\u51b7\u91cf\u6062\u590d\u65f6\u9650\u3002UPS\u768410 min\u7535\u529b\u4fdd\u6301\u4e0d\u7b49\u4e8e10 min\u70ed\u7f13\u51b2\u3002", "xml_paragraph_zero_based": 51}, {"text": "\u8bbe\u8ba1\u76ee\u6807\u4e3a\u7ea6\u5b9a\u5355\u6545\u969c/\u51b7\u6e90\u5207\u6362\u53ca2 h\u8865\u6c34\u4e2d\u65ad\u671f\u95f4IT\u59cb\u7ec8\u6ee1\u8d1f\u8377\uff0c\u4e0d\u5c06IT\u964d\u8f7d\u6216\u505c\u673a\u4f5c\u4e3a\u5408\u683c\u63a5\u7ba1\u65b9\u5f0f\u3002\u8d85\u8fc7\u50a8\u5907\u65f6\u95f4\u3001\u5171\u7528\u63a5\u53e3\u7834\u88c2\u6216\u591a\u91cd\u5171\u56e0\u5931\u6548\u8d85\u51fa\u8be5\u4fdd\u969c\u5305\u7edc\uff0c\u9700\u53e6\u884c\u8bbe\u8ba1\uff1b\u7d27\u6025\u5b89\u5168\u8054\u9501\u4ecd\u4fdd\u7559\uff0c\u89e6\u53d1\u5373\u8868\u793a\u4f9b\u51b7\u8fde\u7eed\u6027\u8981\u6c42\u672a\u6ee1\u8db3\u3002\u5f53\u524d\u672a\u5b8c\u6210\u5b9e\u9645\u5207\u6362\u6216\u77ac\u6001\u8bd5\u9a8c\uff0c\u627f\u8bfa\u6761\u4ef6\u987b\u5199\u5165\u5408\u540c\u5e76\u7531\u4f9b\u5e94\u5546\u9a8c\u8bc1\u3002", "xml_paragraph_zero_based": 52}, {"text": "\u6bcf\u5854\u53caCDU\u4f9b\u56de\u4e24\u7aef\u8bbe\u7f6e\u72ec\u7acb\u7535\u52a8\u9009\u62e9\u9600\uff0c\u5148\u786e\u8ba4\u539f\u73af\u7f51\u9694\u79bb\u518d\u63a5\u5165\u53e6\u4e00\u73af\u7f51\uff1b\u4f9b\u56de\u5fc5\u987b\u540c\u5c5eA\u6216B\u3002\u63a5\u53e3\u5171\u7528\u6bb5\u7f29\u77ed\u81f3\u76f4\u63a5\u8fde\u63a5\u7684\u4e09\u901a\u6bb5\uff0c\u90bb\u8fd1\u652f\u8def\u91c7\u7528\u5bf9\u5939\u8776\u9600\u7269\u7406\u9694\u79bb\u5e76\u53cd\u9988\u9600\u4f4d\u3002\u6b62\u56de\u9600\u4e0d\u80fd\u66ff\u4ee3\u68c0\u4fee\u9694\u79bb\uff0c\u5171\u7528\u63a5\u53e3\u672c\u4f53\u6545\u969c\u4ecd\u9700\u5206\u533a\u5904\u7f6e\u3002", "xml_paragraph_zero_based": 54}, {"text": "\u540c\u7ec4\u56db\u5854\u53ef\u7ecf\u7535\u52a8\u9600\u9009\u62e9A\u6216B\u73af\u7f51\uff0c\u4efb\u4f55\u4e00\u53f0\u5854\u5747\u4e0d\u80fd\u628aA\u4f9b\u4e0eB\u56de\u4e32\u901a\u3002\u4e8c\u6b21\u4fa7\u6bcf6\u67dc\u4e00\u5bf9CDU\u72ec\u7acb\u5907\u7528\uff0c\u673a\u67dc\u5185\u90e8\u4f9b\u56de\u6b67\u7ba1\u4e0d\u7b49\u4e8e\u53cc\u72ec\u7acb\u6db2\u8def\u3002", "xml_paragraph_zero_based": 55}, {"text": "\u5e38\u6001\u5e72\u7403\u226429\u2103\u65f6\uff0c\u4e00\u6b21\u4f9b37\u2103\u3001\u4e8c\u6b21\u4f9b40\u2103\uff1b29\uff5e37\u2103\u4e4b\u95f4\uff0c\u4e8c\u6b21\u76ee\u6807\u968f\u5e72\u7403\u6bcf\u53471\u2103\u4e0a\u8c030.5 K\uff0c\u4e00\u6b21\u4f4e3 K\uff1b\u5e72\u7403\u226537\u2103\u65f6\u4e00\u6b21\u4f9b41\u2103\u3001\u4e8c\u6b21\u4f9b44\u2103\u3002\u673a\u67dc\u4e8c\u6b21\u4f9b\u6db2\u786c\u4e0a\u965045\u2103\uff0c44\u2103\u76ee\u6807\u9884\u75591 K\u6d4b\u91cf\u548c\u52a8\u6001\u88d5\u91cf\u3002\u4e00\u6b21\u4f9b\u6e29\u6d4b\u70b9\u4f4d\u4e8e\u73af\u7f51\u540e\u3001\u8fd0\u884cCDU\u524d\u3002", "xml_paragraph_zero_based": 57}, {"text": "\u6bcf18\u67dc\u51b7\u6e90\u5171\u7528\u6cf5\u7ec44\u53f0\uff0c\u6b63\u5e383\u75281\u5907\u3001\u50a8\u51b7\u6062\u590d\u53ef\u4e34\u65f64\u53f0\u8fd0\u884c\uff1b\u5382\u5bb6\u5019\u9009\u70b9\u5355\u6cf5115 m\u00b3/h\u300134 m\uff0c\u9879\u76ee\u8fd0\u884c\u5355\u6cf5\u7ea6110 m\u00b3/h\uff0c3\u53f0\u5408\u8ba1330 m\u00b3/h\u300230 kW/\u53f0\u4e3a\u4fdd\u7559\u7535\u673a\u9884\u7b97\uff0c\u975e\u5382\u5bb6\u6307\u5b9a\uff0c\u987b\u6838PG25\u66f2\u7ebf\u3001VFD\u7a33\u5b9a\u533a\u53ca\u5173\u6b7b\u626c\u7a0b\u3002 \u6e90\u4fa7\u8bbe\u8ba1\u5305\u7edc96.52 kPa\u3001\u8ba120%\u9009\u578b\u4f59\u91cf115.82 kPa\uff1b34 m\u5382\u5bb6\u70b9\u6309\u03c11009\u6298\u7b97336.43 kPa\uff0c\u5de5\u4f5c\u70b9\u9760\u53d8\u9891\u5339\u914d\uff0c\u4e0d\u80fd\u89c6\u4e3a\u5b9e\u9645\u8fd0\u884c\u626c\u7a0b\u3002\u8d1f\u8377\u4fa7\u6bcfA/B\u73af\u7f512\u53f0100%\u6cf5\u4e00\u7528\u4e00\u5907\uff0c330 m\u00b3/h\u3001\u8fd0\u884c155.92 kPa\u3001\u9009\u578b\u2265187.11 kPa\uff0c\u4fdd\u755937 kW\u3002\u4e8c\u6b21\u9ad8\u6e29\u8fd0\u884c371.81 kPa\uff0c\u4ecd\u4fdd\u755970 m\u00b3/h\u3001500 kPa\u300122 kW\u5019\u9009\u8303\u56f4\uff0c\u987b\u53d8\u9891\u53ca\u5168\u66f2\u7ebf\u6838\u9a8c\u3002\u6e7f\u76d8\u7ba1\u8fd0\u884c0.1\uff5e0.6 MPa\uff1b1 MPa\u8bd5\u538b\u4e0d\u4f5c\u4e3a\u8fd0\u884c\u4e0a\u9650\u3002\u5b9a\u538b\u3001\u9759\u9ad8\u5dee\u3001\u5173\u6b7b\u548c\u77ac\u6001\u672a\u9f50\u65f6\u7edd\u5bf9\u538b\u529b\u4e0d\u586b\u865a\u6784\u5b9a\u503c\u3002", "xml_paragraph_zero_based": 165}, {"text": "\u4e00\u6b21\u6e90\u4fa7\u91c7\u7528\u5df4\u666e\u989d\u5b9a\u7ba1\u5185\u538b\u964d\uff1a\u5e72\u6a21\u575721.14 kPa@110 m\u00b3/h\uff0c\u6e7f\u6a21\u575750.1 kPa@66 m\u00b3/h\uff1b\u5e76\u8054\u6a21\u5757\u4e0d\u7d2f\u52a0\u538b\u964d\u3002\u6e90\u4fa7\u5916\u7ba1\u3001\u6c47\u96c6\u7ba1\u53ca\u9600\u5e73\u8861\u5408\u8ba1\u668218.9 kPa\uff0c\u7f13\u51b2\u63a5\u53e320 kPa\u3002\u53d8\u5de5\u51b5\u7cfb\u6570\u66821.15\u540e\uff0c\u5e72\u6e90\u56de\u8def63.21 kPa\u3001\u6e7f\u6e90\u56de\u8def96.52 kPa\uff1b\u8d1f\u8377\u4fa7\u4e3a\u4e09\u82b174.714\u00d71.15\uff0b\u5185\u90e850\uff0b\u63a5\u53e320\uff1d155.92 kPa\u3002\u4e24\u56de\u8def\u5206\u5c42\u7f50\u89e3\u8026\uff0c\u5408\u8ba1\u4ec5\u7528\u4e8e\u6cf5\u70ed\u548c\u80fd\u8017\uff0c\u4e0d\u4f5c\u4e3a\u5355\u6cf5\u626c\u7a0b\u3002\u6b6415%\u7cfb\u6570\u662f\u7f3a\u66f2\u7ebf\u65f6\u7684\u5de5\u7a0b\u654f\u611f\u6027\u53c2\u6570\uff0c\u4e0d\u662f\u5382\u5bb6\u4fdd\u8bc1\uff0c\u4e5f\u4e0d\u8986\u76d6\u4f4e\u6e29\u542f\u52a8\u3002\u4e8c\u6b21\u4ecd\u4ee5DN100\u5185\u5f84102.26 mm\u3001\u76f4\u6bb5120 m\u3001\u03a3K20\u3001f0.022\u4e3a\u8def\u5f84\u9884\u7b97\uff1b\u5b9e\u9645\u51e0\u4f55\u3001\u96c6\u7ba1\u548c\u9600Kv\u5f85\u6df1\u5316\u3002", "xml_paragraph_zero_based": 172}, {"text": "\u5907\u7528\u7f50\u91c7\u7528\u5206\u6bb5\u8865\u51b7\uff1a\u8fd0\u884cA\u65f6\u77ed\u65f6\u5207\u5171\u7528\u6e90\u6cf5\u7ed9B\u8865\u51b7\uff0c\u9650\u65f6\u8fd4\u56deA\u540e\u5141\u8bb8\u7b2c4\u53f0\u6e90\u6cf5\u4e34\u65f6\u6295\u5165\uff1b\u8d1f\u8377\u4fa7\u4fdd\u6301330 m\u00b3/h\uff0c\u7528\u6e90\u4fa7\u9ad8\u4e8e\u8d1f\u8377\u4fa7\u7684\u6709\u6548\u51b7\u6db2\u6d41\u91cf\u6062\u590dA\u50a8\u51b7\u91cf\u3002A\u6062\u590d\u5408\u683c\u540e\u65b9\u53ef\u8fdb\u884c\u4e0b\u4e00\u8f6eB\u8865\u51b7\uff1bB\u8fd0\u884c\u65f6\u5bf9\u79f0\u6267\u884c\u3002\u4e0d\u65b0\u589e\u56de\u5145\u6cf5\uff0c\u4e0d\u91c7\u7528\u53cc\u6e7f\u5854\u5206\u522b\u7ed9A/B\u540c\u65f6\u4f9b\u51b7\u7684\u72ec\u7acb\u56de\u5145\u65b9\u6848\u3002", "xml_paragraph_zero_based": 175}, {"text": "\u6b63\u5e38\u6e90\u4fa73\u75281\u5907\u3001330 m\u00b3/h\uff1b\u56db\u6cf5\u6062\u590d\u9636\u6bb5\u603b\u6d41\u91cf\u6309\u6cf5\u5e76\u8054\u5de5\u4f5c\u70b9\u3001\u51b7\u5854\u6d41\u91cf\u4e0e\u6392\u70ed\u80fd\u529b\u3001\u7ba1\u9600\u538b\u964d\u53ca\u4f9b\u6e29\u5171\u540c\u9650\u5e45\uff0c440 m\u00b3/h\u4ec5\u4e3a4\u00d7110\u7684\u7b97\u4f8b\uff0c\u4e0d\u662f\u8fd0\u884c\u8bbe\u5b9a\u6216\u5382\u5bb6\u4fdd\u8bc1\u3002\u4e00\u6b21A/B\u59cb\u7ec8\u4e0d\u5e76\u901a\uff0c\u51b7\u6e90\u6301\u7eed\u8fd0\u884c\u7ec4\u5408\u4ecd\u4ec51\u5e72\u30011\u5e72\uff0b1\u6e7f\u62161\u6e7f\u3002", "xml_paragraph_zero_based": 176}, {"text": "\u56db\u6cf5\u4e34\u65f6\u8fd0\u884c\u671f\u95f4\u65e0\u95f2\u7f6e\u5907\u7528\u6cf5\u3002\u4efb\u4e00\u6cf5\u6545\u969c\u7acb\u5373\u7ec8\u6b62\u50a8\u51b7\u6062\u590d\uff0c\u4f18\u5148\u4fdd\u969c\u8fd0\u884c\u73af\u7f51330 m\u00b3/h\uff1b\u5269\u4f59\u4e09\u6cf5\u80fd\u5426\u63a5\u7ba1\u53ca