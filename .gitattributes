# Store every text file with LF in the repository and check it out with LF,
# independent of a contributor's core.autocrlf setting. This keeps the frozen
# contract and report hashes in PHASE2_REVIEW_SUMMARY.md reproducible across
# Windows, Linux and macOS checkouts.
* text=auto eol=lf

# Declared explicitly so a later edit to the line above cannot silently change
# how these are stored.
*.py           text eol=lf
*.md           text eol=lf
*.toml         text eol=lf
*.cfg          text eol=lf
*.ini          text eol=lf
*.txt          text eol=lf
*.json         text eol=lf
*.csv          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.sh           text eol=lf
LICENSE        text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# Never normalize or diff these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.whl   binary
*.zip   binary
